{
    "ociVersion": "1.0.1",
    "process": {
        "args": [
            "/bin/echo", "OK"
        ],
        "env": [
            "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "TERM=xterm"
        ],
        "cwd": "/"
    },
    "root": {
        "path": "./rootfs",
        "readonly": true
    },
    "hostname": "clobenox",
    "mounts": [
        {
            "destination": "/proc",
            "type": "proc",
            "source": "proc"
        },
        {
        "destination": "/home",
        "type": "none",
        "source": "/home/bind",
        "options": [
            "bind"
        ]
        }
    ],
    "_tmpfs": { 
        "destination": "/tmp",
        "type": "tmpfs",
        "source": "tmpfs"
    },
    "": {
        "destination": "/data",
        "type": "none",
        "source": "/home/bind",
        "options": [
            "bind"
        ]
    }
}
